import random as rd
import copy

def medianAux(List, k): #fonction qui trouve le k-ème plus petit élément dans une liste
    if len(List)<=4:
        List.sort()
        return List[k-1]
    n = len(List)
    q = n//5
    Lsepare = [[List[5*i+j] for j in range(5)] for i in range(q)]
    for i in range(q):
        Lsepare[i].sort()
    pivot = medianAux([Lsepare[i][2] for i in range(q)],q//2)
    Lpivot1 = []
    Lpivot2 = []
    for x in List :
        if x <= pivot :
            Lpivot1.append(x)
        else :
            Lpivot2.append(x)
    if len(Lpivot1)>=k :
        return medianAux(Lpivot1,k)
    else :
        return medianAux(Lpivot2,k-len(Lpivot1))

def median(List):
    return medianAux(List,len(List)//2)


def oneSide(List,x):
    global upper
    n = len(List)
    if List[0][0] < x: #on trouve deux indices i et j tels que x_i < x < x_j
        i = 0
        j = 1
        while j < n and List[j][0] < x : #par hypothèse sur x, on trouvera forcément j vérifiant x < x_j
            j+=1
    if List[0][0] > x:
        j = 0
        i = 1
        while i < n and List[i][0] > x :
            i+=1
    ordre = []
    for k in range(n):
        if k!=i and k!=j:
            ordre.append(k)
    rd.shuffle(ordre) #on tire l'ordre dans lequel on va ajouter nos points.
    baseg = List[i]
    based = List[j]
    for k in ordre:
        if List[k][1] > (based[1]-baseg[1])/(based[0]-baseg[0])*(List[k][0]-baseg[0])+baseg[1]:
            if List[k][0] > x:
                based = List[k]
            else :
                baseg = List[k]
    if upper :
        Reponse.append((baseg,based))
    else :
        Reponse.append(([baseg[0],-baseg[1]],[based[0],-based[1]]))
    return (baseg,based)
    


def upperhull(List): 
    global upper
    n = len(List)
    if n <= 1 :
        return 
    if n == 2:
        if upper :
            Reponse.append((List[0],List[1]))
        else :
            Reponse.append(([List[0][0],-List[0][1]],[List[1][0],-List[1][1]]))
        return
    med = median([List[k][0] for k in range(n)])
    medbis = medianAux([List[k][0] for k in range(n)],len(List)//2+1)
    x = (med+medbis)/2 #on s'assure de trouver un x différent des x_i
    baseg,based = oneSide(List,x)
    Listg = []
    Listd = []
    for y in List:
        if y[0]<=baseg[0]:
            Listg.append(y)
        if y[0]>=based[0]: 
            Listd.append(y)
    upperhull(Listg)
    upperhull(Listd)
    return 

